  "i2c": {
    "I2C0": {
      "gpio_sda": 4,
      "gpio_scl": 5,
      "frequency_hz": 400000,
      "devices": {
        "hall_muxes": [
          {
            "ref": "U3",
            "part": "TCA9548APWR",
            "address": 112
          },
          {
            "ref": "U4",
            "part": "TCA9548APWR",
            "address": 113
          },
          {
            "ref": "U5",
            "part": "TCA9548APWR",
            "address": 114
          }
        ],
        "touch": [
          {
            "ref": "U_TOUCH1",
            "part": "MPR121QR2",
            "address": 90
          },
          {
            "ref": "U_TOUCH2",
            "part": "MPR121QR2",
            "address": 91
          }
        ]
      },
      "rules": [
        "All TMAG5273 sensors use address 0x35.",
        "Enable at most one Hall mux channel across all three TCA9548A devices at a time.",
        "Close every Hall mux channel before switching to the next sensor.",
        "TCA_RESET is hardware-pulled high and is not connected to a Pico GPIO.",
        "Use the shared active-low TOUCH_IRQ on GP21; do not continuously poll both MPR121 devices."
      ]
    },
    "I2C1": {
      "gpio_sda": 6,
      "gpio_scl": 7,
      "frequency_hz": 400000,
      "devices": {
        "haptic_pwm": [
          {
            "ref": "U_HAPTIC1",
            "part": "PCA9685PW,118",
            "address": 96
          },
          {
            "ref": "U_HAPTIC2",
            "part": "PCA9685PW,118",
            "address": 97
          }
        ],
        "led_mux_control": {
          "ref": "U12",
          "part": "TCA9554PWR",
          "address": 32
        }
      },
      "rules": [
        "Configure PCA9685 MODE2.OUTDRV=1 (totem-pole); motor MOSFET gates require driven-high outputs.",
        "PCA9685 OE is tied to ground, so firmware cannot use OE as a kill switch.",
        "PCA9685 EXTCLK is grounded; use the internal oscillator.",
        "GP20 is the shared A5 address strap and must remain input/high-Z.",
        "Motor channels are active-high; function-button LED channels are active-low current sinks."
      ]
    }
  },
