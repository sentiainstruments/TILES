; SK6805-EC15 one-wire addressable RGB LED protocol, 800kb/s NZR bit
; encoding: a 0 bit is a short high pulse then a long low pulse, a 1 bit
; is a long high pulse then a short low pulse. Same protocol family as
; WS2812; this mirrors Raspberry Pi's reference ws2812.pio bit timing
; (T1=2, T2=5, T3=3 cycles) rather than re-deriving it, since getting
; the high/low pulse widths wrong produces LEDs that silently latch the
; wrong colors -- see drivers/sk6805.c for the clock-divider math that
; turns these cycle counts into an 800kHz bit rate.

.program sk6805
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1        side 0 [T3 - 1]
    jmp !x do_zero  side 1 [T1 - 1]
do_one:
    jmp  bitloop    side 1 [T2 - 1]
do_zero:
    nop             side 0 [T2 - 1]
.wrap
